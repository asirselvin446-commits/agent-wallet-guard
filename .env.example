# Supabase PostgreSQL connection string. Copy the Prisma URL from Supabase:
# Project Settings -> Database -> Connect -> Prisma.
# Shared transaction-mode pooler; used by the application at runtime.
DATABASE_URL="postgresql://postgres.qampqnlebasoczarymcn:YOUR_PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Shared session-mode pooler; used by Prisma migrations/schema operations.
DIRECT_URL="postgresql://postgres.qampqnlebasoczarymcn:YOUR_PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"
PAYPAL_CLIENT_ID=""
